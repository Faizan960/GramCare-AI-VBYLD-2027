# GramCare AI Environment Configuration Template
# DO NOT commit real secrets, credentials, or production connection strings to version control.
# Copy this file to .env for local development.

# Environment Mode
NODE_ENV=development
PORT=5000

# Central PostgreSQL Database (Development placeholder)
DATABASE_URL=postgresql://gramcare_user:placeholder_password@localhost:5432/gramcare_db

# Authentication / JWT
JWT_SECRET=replace_with_secure_random_secret_in_local_env
JWT_EXPIRES_IN=24h

# Dashboard URL (CORS)
DASHBOARD_URL=http://localhost:5173

# Demo & Simulation Mode
ENABLE_DEMO_DATA=true
